# Files matching these patterns are excluded from auto-resolve: Copado stops with "Merge Conflict".
# Pattern syntax is the same as for .gitignore files (last matching rule wins).
# Docs: https://docs.copado.com/articles/copado-pipelines-publication/merge-conflict-resolution-overview-and-types

# Exclude everything ...
**/*
# ... but include folders again, otherwise the "!" rules below cannot include files again (gitignore rule)
!**/*/

# Keep auto-resolve (semantic merge) for these types
!**/profiles/**
!**/permissionsets/**
!**/mutingpermissionsets/**
!**/labels/**
!**/translations/**
!**/workflows/**
!**/sharingRules/**
!**/escalationRules/**
!**/duplicateRules/**
!**/matchingRules/**
!**/assignmentRules/**
!**/autoResponseRules/**
